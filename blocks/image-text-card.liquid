{%- liquid
  assign s = block.settings

  comment — Aspect ratio (mirrors image.liquid exactly)
  endcomment
  case s.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'square'
      assign ratio = '1 / 1'
    when 'adapt'
      assign ratio = s.image.aspect_ratio
  endcase
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  comment — Map content_position to flex vars
  endcomment
  case s.content_position
    when 'top-left'
      assign content_v = 'flex-start'
      assign content_h = 'flex-start'
    when 'top-center'
      assign content_v = 'flex-start'
      assign content_h = 'center'
    when 'top-right'
      assign content_v = 'flex-start'
      assign content_h = 'flex-end'
    when 'middle-left'
      assign content_v = 'center'
      assign content_h = 'flex-start'
    when 'middle-center'
      assign content_v = 'center'
      assign content_h = 'center'
    when 'middle-right'
      assign content_v = 'center'
      assign content_h = 'flex-end'
    when 'bottom-left'
      assign content_v = 'flex-end'
      assign content_h = 'flex-start'
    when 'bottom-center'
      assign content_v = 'flex-end'
      assign content_h = 'center'
    when 'bottom-right'
      assign content_v = 'flex-end'
      assign content_h = 'flex-end'
    else
      assign content_v = 'flex-end'
      assign content_h = 'flex-start'
  endcase

  comment — Responsive image sizes (mirrors image.liquid)
  endcomment
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign img_sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign img_widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
-%}

{%- capture children -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

{%- capture card_inner -%}
  <div class="image-text-card__media">

    {%- if s.image -%}
      {{
        s.image
        | image_url: width: 2560
        | image_tag:
          class: 'image-text-card__img image-text-card__img--primary',
          widths: img_widths,
          sizes: img_sizes,
          width: s.image.width,
          height: s.image.height,
          alt: s.image.alt
      }}
    {%- else -%}
      <div class="image-text-card__placeholder image-text-card__img--primary">
        {{- 'detailed-apparel-1' | placeholder_svg_tag -}}
      </div>
    {%- endif -%}

    {%- if s.hover_image -%}
      {{
        s.hover_image
        | image_url: width: 2560
        | image_tag:
          class: 'image-text-card__img image-text-card__img--hover',
          widths: img_widths,
          sizes: img_sizes,
          loading: 'lazy',
          width: s.hover_image.width,
          height: s.hover_image.height,
          alt: s.hover_image.alt
      }}
    {%- endif -%}

    {%- if s.toggle_overlay -%}
      {%- render 'overlay', settings: s -%}
    {%- endif -%}

  </div>

  {%- unless children == blank -%}
    <div class="image-text-card__content">
      {{ children }}
    </div>
  {%- endunless -%}
{%- endcapture -%}

{%- capture wrapper_class -%}
  image-text-card image-text-card--height-{{ s.height }} spacing-style size-style
{%- endcapture -%}

{%- capture wrapper_style -%}
  --ratio: {{ ratio }};
  --image-fit: {{ s.image_fit | default: 'cover' }};
  --content-v: {{ content_v }};
  --content-h: {{ content_h }};
  --content-padding: {{ s.content_padding | default: 16 }}px;
  --horizontal-alignment: {{ content_h }};
  --size-style-width: {% if s.width == 'half' %}50%{% else %}100%{% endif %};
  --size-style-width-mobile: {% if s.width_mobile == 'half' %}50%{% else %}100%{% endif %};
  {% render 'spacing-style', settings: s %}
  {% render 'border-override', settings: s %}
{%- endcapture -%}

{%- if s.link != blank -%}
  <a
    href="{{ s.link }}"
    class="{{ wrapper_class }}"
    style="{{ wrapper_style | strip_newlines }}"
    {{ block.shopify_attributes }}
  >
    {{ card_inner }}
  </a>
{%- else -%}
  <div
    class="{{ wrapper_class }}"
    style="{{ wrapper_style | strip_newlines }}"
    {{ block.shopify_attributes }}
  >
    {{ card_inner }}
  </div>
{%- endif -%}

{% stylesheet %}
  /* ── Wrapper ──────────────────────────────────── */
  .image-text-card {
    position: relative;
    display: block;
    text-decoration: none;
  }

  /* Height fill: let the media container stretch to the parent height */
  .image-text-card--height-fill .image-text-card__media {
    height: 100%;
    aspect-ratio: unset;
  }

  /* ── Media container ──────────────────────────── */
  .image-text-card__media {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: var(--border-radius, 0px);
    border-width: var(--border-width, 0);
    border-style: var(--border-style, none);
    border-color: var(--border-color, transparent);
  }

  /* ── Images ───────────────────────────────────── */
  .image-text-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--image-fit, cover);
    display: block;
    transition: opacity var(--animation-speed) var(--animation-easing);
  }

  .image-text-card__img--hover {
    opacity: 0;
  }

  .image-text-card:hover .image-text-card__img--hover {
    opacity: 1;
  }

  .image-text-card:hover .image-text-card__img--primary:not(:only-of-type) {
    opacity: 0;
  }

  /* ── Placeholder ──────────────────────────────── */
  .image-text-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .image-text-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* ── Content overlay ──────────────────────────── */
  .image-text-card__content {
    position: absolute;
    inset: 0;
    z-index: var(--layer-raised, 1);
    display: flex;
    flex-direction: column;
    justify-content: var(--content-v, flex-end);
    align-items: var(--content-h, flex-start);
    padding: var(--content-padding, 1rem);
    pointer-events: none;
  }

  .image-text-card__content > * {
    pointer-events: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image Text Card",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
