{%- doc -%}
  Mega Menu Promotion block.

  Rendered via content_for 'block', type: '_mega-menu-promo', id: sb.id calls in
  _header-menu.liquid (desktop) and header-drawer.liquid (mobile). The caller
  already filters by menu_link_title, so this block simply counts its active
  images and delegates rendering to snippets/mega-menu-promo.liquid.

  Pass is_mobile: true from the caller to switch to the two-column mobile layout.

  Add one block per menu item that needs promotional cards (e.g. one for
  "The Shop", one for "Sale"). Set menu_link_title to the exact nav item label.
{%- enddoc -%}

{% liquid
  assign promo_count = 0
  for i in (1..5)
    assign image_key = 'promo_' | append: i | append: '_image'
    if block.settings[image_key] != blank
      assign promo_count = promo_count | plus: 1
    endif
  endfor
%}
{%- assign raw_handle = block.settings.menu_link_title | strip -%}
{%- if raw_handle == '-' or raw_handle == blank -%}
  {%- assign block_handle = 'default' -%}
{%- else -%}
  {%- assign block_handle = raw_handle | handleize -%}
{%- endif -%}

{%- if promo_count > 0 -%}
  <div
    class="mega-menu-promo-block"
    data-handle="{{ block_handle }}"
    data-promo-handle="{{ block_handle }}"
    {{ block.shopify_attributes }}
  >
    {%- render 'mega-menu-promo', promo_block: block, promo_count: promo_count, is_mobile: is_mobile -%}
  </div>
{%- endif -%}

