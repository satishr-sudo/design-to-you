    "custom_liquid_4hA3Wd": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .dty-thread-options {\n  --dty-navy: #111a3a;\n  width: 100%;\n  max-width: 100%;\n  margin: 0;\n  padding: 0 0 10px;\n  color: var(--dty-navy);\n}\n\n  .dty-thread-options,\n  .dty-thread-options * {\n    box-sizing: border-box;\n  }\n\n  /* MAIN DESKTOP LAYOUT */\n\n  .dty-thread-options__layout {\n    display: grid;\n    grid-template-columns: minmax(0, 2fr) minmax(330px, 1fr);\n    gap: clamp(40px, 5vw, 72px);\n    align-items: start;\n    width: 100%;\n  }\n\n  /* COLOUR GRID */\n\n  .dty-thread-options__colours {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(100px, 1fr));\n    gap: 24px;\n    min-width: 0;\n  }\n\n  .dty-thread-swatch {\n    position: relative;\n    width: 100%;\n    min-width: 0;\n    min-height: 130px;\n    aspect-ratio: 1 / 0.97;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    padding: 18px 8px;\n    overflow: hidden;\n    border: 1px solid rgba(17, 26, 58, 0.06);\n    border-radius: 5px;\n    background-color: var(--swatch-colour);\n    box-shadow: 0 7px 10px rgba(17, 26, 58, 0.15);\n  }\n\n  .dty-thread-swatch__label {\n    position: relative;\n    z-index: 1;\n    color: var(--label-colour, #ffffff);\n    font-family: \"area-normal\", sans-serif;\n    font-size: 14px;\n    font-weight: 400;\n    line-height: 1.2;\n    letter-spacing: 0;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  /* FONT SAMPLES */\n\n  .dty-thread-options__samples {\n    display: grid;\n    gap: 38px;\n    min-width: 0;\n  }\n\n  .dty-font-sample {\n    width: 100%;\n    min-width: 0;\n  }\n\n  .dty-font-sample__title {\n    margin: 0 0 14px;\n    color: var(--dty-navy);\n    font-family: \"area-normal\", sans-serif;\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1.3;\n    text-transform: uppercase;\n  }\n\n  .dty-font-sample__image {\n    display: block;\n    width: 100%;\n    height: 164px;\n    object-fit: cover;\n    border: 0;\n    border-radius: 0;\n    background-color: #f5f4f1;\n  }\n\n  /* TABLET */\n\n  @media screen and (max-width: 1100px) {\n      .dty-thread-options__layout {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 46px;\n    }\n\n    .dty-thread-options__colours {\n      grid-template-columns: repeat(5, minmax(0, 1fr));\n      gap: 18px;\n    }\n\n    .dty-thread-swatch {\n      min-height: 110px;\n    }\n\n    .dty-thread-options__samples {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 24px;\n    }\n  }\n\n  /* MOBILE */\n\n  @media screen and (max-width: 749px) {\n    .dty-thread-options {\n  width: 100%;\n  max-width: 100%;\n  padding: 0 0 10px;\n}\n\n    .dty-thread-options__layout {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 38px;\n    }\n\n    .dty-thread-options__colours {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      gap: 14px;\n    }\n\n    .dty-thread-swatch {\n      min-height: 95px;\n      padding: 15px 5px;\n      box-shadow: 0 5px 8px rgba(17, 26, 58, 0.14);\n    }\n\n    .dty-thread-swatch__label {\n      font-size: 11px;\n    }\n\n    .dty-thread-options__samples {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 30px;\n    }\n\n    .dty-font-sample__title {\n      margin-bottom: 10px;\n      font-size: 15px;\n    }\n\n    .dty-font-sample__image {\n      width: 100%;\n      height: auto;\n      min-height: 115px;\n      object-fit: cover;\n    }\n  }\n\n  /* SMALL MOBILE */\n\n  @media screen and (max-width: 390px) {\n\n    .dty-thread-options__colours {\n      gap: 10px;\n    }\n\n    .dty-thread-swatch {\n      min-height: 88px;\n    }\n\n    .dty-thread-swatch__label {\n      font-size: 10px;\n    }\n  }\n</style>\n\n<section class=\"dty-thread-options\">\n\n  <div class=\"dty-thread-options__layout\">\n\n    <!-- THREAD COLOURS -->\n\n    <div class=\"dty-thread-options__colours\">\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #050505;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Black</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #35324f;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Navy</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #345d36;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Forest</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #c5293a;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Red</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #cdae62;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Gold</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #575757;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Charcoal</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #506daf;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Cobalt</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #68a9a1;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Teal</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #ce5b8e;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Hot Pink</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #c8c8c8;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Silver</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #b1b1b1;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Mid Gray</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #bdcce4;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Pale Blue</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #b4d7d3;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Mint</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"--swatch-colour: #e5b8c5;\"\n      >\n        <span class=\"dty-thread-swatch__label\">Blush</span>\n      </div>\n\n      <div\n        class=\"dty-thread-swatch\"\n        style=\"\n          --swatch-colour: #ffffff;\n          --label-colour: #111a3a;\n        \"\n      >\n        <span class=\"dty-thread-swatch__label\">White</span>\n      </div>\n\n    </div>\n\n    <!-- FONT SAMPLE IMAGES -->\n\n    <div class=\"dty-thread-options__samples\">\n\n      <div class=\"dty-font-sample\">\n\n        <h3 class=\"dty-font-sample__title\">\n          Block Font\n        </h3>\n\n        <img\n          class=\"dty-font-sample__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0711/7003/1803/files/emb-block-font_fa24cfdf-b3cd-4eec-8e78-465469ba706c.webp?v=1787100549\"\n          alt=\"Block font embroidery sample\"\n          loading=\"lazy\"\n        >\n\n      </div>\n\n      <div class=\"dty-font-sample\">\n\n        <h3 class=\"dty-font-sample__title\">\n          Script Font\n        </h3>\n\n        <img\n          class=\"dty-font-sample__image\"\n          src=\"https://cdn.shopify.com/s/files/1/0711/7003/1803/files/emb-script-font_c9ac4592-a3c7-45ad-97f6-a550ce92b06e.webp?v=1787100549\"\n          alt=\"Script font embroidery sample\"\n          loading=\"lazy\"\n        >\n\n      </div>\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 20,
        "padding-block-end": 80
      }
    }
  },
