            "custom_liquid": "<style>\n@media screen and (max-width: 749px) {\n  .dty-table.dty-table--compact {\n    width: 100%;\n    min-width: 0 !important;\n    table-layout: fixed;\n  }\n\n  .dty-table.dty-table--compact td {\n    white-space: normal;\n    overflow-wrap: break-word;\n  }\n}\n</style>\n<div class=\"dty-delivery-card\">\n  <h4>Processing Times</h4>\n\n  <div class=\"dty-table-wrap\">\n    <table class=\"dty-table dty-table--compact\">\n      <tbody>\n        <tr>\n          <td>Non-embroidered items</td>\n          <td>1–2 business days</td>\n        </tr>\n\n        <tr>\n          <td>Embroidered items</td>\n          <td>5–10 business days</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</div>"
