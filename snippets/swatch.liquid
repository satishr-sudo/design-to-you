{%- doc -%}
  Renders a swatch either from a variant image object, a swatch object, or a product option value.

  @param {object} [swatch] - a swatch object
  @param {object} [option_value] - a product option value object; swatch and colour name are derived from it
  @param {object} [variant_image] - an alternate image when there is no swatch value
  @param {string} [mode] - one of 'unscaled', 'filter', 'pill'

  @example
  {% render 'swatch', swatch: swatch, variant_image: variant_image, mode: 'unscaled' %}
  {% render 'swatch', option_value: product_option_value, variant_image: variant_image, mode: 'unscaled' %}
{%- enddoc -%}

{% liquid
  if option_value
    assign swatch = option_value.swatch
  endif

  assign swatch_value = null
  assign colour_name = null
  assign extra_classes = ''

  if settings.show_variant_image and variant_image
    assign swatch_image_width = settings.variant_swatch_width | times: 2
    assign swatch_image_url = variant_image | image_url: width: swatch_image_width
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
    assign extra_classes = extra_classes | append: ' swatch--variant-image'
  elsif swatch.image
    assign swatch_image_url = swatch.image | image_url: width: 80
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
  elsif swatch.color
    assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
  elsif option_value
    assign colour_name = option_value.name | downcase | replace: ' ', ''
    case colour_name
      when 'watermelon'
        assign swatch_value = '#f6696b'
      when 'sangria'
        assign swatch_value = '#731b2e'
      when 'fern'
        assign swatch_value = '#0c4c44'
      when 'theog'
        assign swatch_value = '#008d74'
      when 'coolmint'
        assign swatch_value = '#5fbbab'
      when 'ocean'
        assign swatch_value = '#2951a4'
      when 'midnight'
        assign swatch_value = '#2b2b2b'
      when 'charcoal'
        assign swatch_value = '#5e5e5e'
      when 'emerald'
        assign swatch_value = '#24b593'
      when 'bluejay'
        assign swatch_value = '#1d57ba'
      when 'aegeanblue'
        assign swatch_value = '#0b80bc'
      when 'stormgrey'
        assign swatch_value = '#636167'
      when 'ruby'
        assign swatch_value = '#b70101'
      when 'coolgrey'
        assign swatch_value = '#afaeb2'
      when 'marine'
        assign swatch_value = '#1e86cc'
      when 'twilightnavy'
        assign swatch_value = '#002c54'
      when 'lagoon'
        assign swatch_value = '#05647d'
      when 'frenchnavy'
        assign swatch_value = '#002b44'
      when 'azure'
        assign swatch_value = '#008db5'
      when 'charcoalmarle'
        assign swatch_value = '#777777'
      when 'grey'
        assign swatch_value = '#eaeaed'
      when 'greymarle'
        assign swatch_value = '#808080'
      when 'gunmetal'
        assign swatch_value = '#3c3c3c'
      when 'ivory'
        assign swatch_value = '#fcfcf4'
      when 'midnightblack'
        assign swatch_value = '#2b2b2b'
      when 'navy'
        assign swatch_value = '#00275b'
      when 'oceanblue'
        assign swatch_value = '#0f435c'
      when 'royal'
        assign swatch_value = '#2f519f'
      when 'teal'
        assign swatch_value = '#3f989f'
      when 'twilight'
        assign swatch_value = '#002c54'
      when 'yellow'
        assign swatch_value = '#FFFF00'
      when 'white'
        assign swatch_value = '#FFFFFF'
      when 'black'
        assign swatch_value = '#000000'
      when 'red'
        assign swatch_value = '#FF0000'
      else
        assign swatch_value = colour_name
    endcase
  endif

  case mode
    when 'unscaled'
      assign extra_classes = extra_classes | append: ' swatch--unscaled'
    when 'filter'
      assign extra_classes = extra_classes | append: ' swatch--filter'
    when 'pill'
      assign extra_classes = extra_classes | append: ' swatch--pill'
  endcase
%}

<span
  class="
    swatch
    {{ extra_classes }}
    {% if swatch_value == null %} swatch--unavailable{% endif %}
  "
  {% if colour_name %}data-colour="{{ colour_name }}"{% endif %}
  style="
    --swatch-background: {{ swatch_value }};
    {% if swatch.image and settings.show_variant_image == false %} --swatch-focal-point: {{ swatch.image.presentation.focal_point }};{% endif %}
  "
>
</span>
