
{% liquid
  assign max_items = section.settings.max_collections

  if section.settings.layout_type == 'bento'
    assign max_items = 4
  endif

  if section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    if section.settings.layout_type == 'bento'
      assign max_items = 4
    else
      assign max_items = section.settings.collection_list.count | at_most: section.settings.max_collections
    endif
  endif
%}

{% if section.settings.layout_type == 'carousel' %}
  <style>
    #shopify-section-{{ section.id }} slideshow-component {
      timeline-scope: var(--slideshow-timeline), --cls-scroll;
    }
    #shopify-section-{{ section.id }} .collection-list-slider__inner slideshow-slides {
      scroll-timeline-name: --cls-scroll;
      scroll-timeline-axis: inline;
    }
  </style>
{% endif %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="collection-list-slider"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    collection-list-slider
    spacing-style
    gap-style
    {% if section.settings.custom_class_name  %}{{ section.settings.custom_class_name }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>

  {% capture list_items %}
    {% if section_collections != null %}
      {% for collection in section_collections limit: max_items %}
        <div class="resource-list__item">
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>
        {% unless forloop.last %}<!--@list/split-->{% endunless %}
      {% endfor %}
    {% else %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>
        {% unless forloop.last %}<!--@list/split-->{% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% if section.settings.layout_type == 'carousel' %}

    {% liquid
      if section.settings.section_width == 'page-width'
        assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
        if section.settings.header_position == 'left'
          assign slideshow_gutters = 'end'
        else
          assign slideshow_gutters = 'start end'
        endif
      else
        assign slideshow_gutters = null
        assign gutter_style = '--gutter-slide-width: 0px;'
      endif
    %}

    {% capture carousel_slides %}
      {% for item in list_items_array %}
        {% render 'slideshow-slide',
          index: forloop.index0,
          children: item,
          class: 'resource-list__slide'
        %}
      {% endfor %}
    {% endcapture %}

    {% capture carousel_footer %}
      <div class="collection-list-slider__footer">
        <div class="collection-list-slider__nav">
          {%- render 'slideshow-arrow', action: 'previous', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape -%}
          {%- render 'slideshow-arrow', action: 'next', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape -%}
        </div>
        <div class="collection-list-slider__progress-track">
          <div class="collection-list-slider__progress-fill"></div>
        </div>
      </div>
    {% endcapture %}

    <div class="collection-list-slider__layout force-full-width {% if section.settings.header_position != 'left' %} collection-list-slider__layout--top{% endif %}">

      <div class="collection-list-slider__header" style="--content-width: {{ section.settings.content_width | default: 300 }}px;">
        {%- content_for 'blocks' -%}
      </div>

      <div
        class="collection-list-slider__inner resource-list resource-list__carousel"
        style="
          --resource-list-column-gap-desktop: {{ section.settings.columns_gap }}px;
          --column-count: {{ section.settings.columns }};
          --column-count-mobile: 1;
          --mobile-card-size: {{ section.settings.mobile_card_size | default: '60cqw' }};
        "
      >
        <div class="resource-list__carousel" style="--slide-width-max: 450px; {{ gutter_style }}">
          {% render 'slideshow',
            ref: 'collectionListSlider',
            class: 'resource-list__carousel',
            slides: carousel_slides,
            show_arrows: false,
            controls: carousel_footer,
            auto_hide_controls: false,
            infinite: false,
            slide_count: max_items,
            slideshow_gutters: slideshow_gutters
          %}
        </div>
      </div>

    </div>

  {% else %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      carousel_ref: 'collectionListSlider',
      slide_count: max_items,
      content_type: 'collections',
      test_id: 'collection-list-slider-grid'
    %}

  {% endif %}

</div>

