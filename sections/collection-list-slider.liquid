{% stylesheet %}
  .collection-list-slider__layout {
    display: flex;
    flex-wrap:wrap;
    align-items: stretch;
    gap:var(--gap);

  }

  @media screen and (min-width: 750px) {
    .section--page-width .collection-list-slider__layout:not(.collection-list-slider__layout--top) {
      padding-inline-start: var(--util-page-margin-offset);
      gap:var(--gap);
    }
  }

  .collection-list-slider__layout--top {
    flex-direction: column;
  }

  .section--page-width .collection-list-slider__layout--top .collection-list-slider__header {
    padding-inline: var(--util-page-margin-offset);
  }

  @media screen and (max-width: 749px) {
    .collection-list-slider__layout {
      flex-direction: column;
      gap: var(--gap, 1.5rem);
    }
  }

  .collection-list-slider__header {
    flex-shrink: 0;
  }
  @media screen and (min-width: 750px) {
    .collection-list-slider__layout:not(.collection-list-slider__layout--top) .collection-list-slider__header {
      flex-basis: var(--content-width);
      max-width: var(--content-width);
    }
  }

  .collection-list-slider__inner {
    flex: 1;
    min-width: 0;
     
  }

  .collection-list-slider__footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block-start: 1.5rem;
    padding-inline: var(--gutter-slide-width, 0px);
   
  }

  .collection-list-slider__nav {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap:20px;
  }

  .collection-list-slider__progress-track {
    flex: 1;
    height: 3px;
    background-color: #e3e3e3;
    position: relative;
    overflow: hidden;
    max-width:400px;
    border-radius:50px;
  }

  .collection-list-slider__progress-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: #240000;
    transform-origin: left;
    transform: scaleX(0);
    animation: collection-list-slider-progress linear both;
    animation-timeline: --cls-scroll;
  }

  @keyframes collection-list-slider-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
 .collection-list-custom .collection-list-slider__footer button.slideshow-control{
  display: flex;
  align-items: center;
}
  .collection-list-custom .collection-list-slider__footer .svg-wrapper.icon-arrow
 {
    color: var(--color-input-background);
    height:auto;
    width: auto;
}
.collection-list-custom .collection-list-slider__footer .svg-wrapper.icon-arrow svg

 {
    width:var(--icon-size-lg);
    height:var(--icon-size-lg);
}
@media(min-width:750px){
.collection-list-custom.slide-control-no-gutter .collection-list-slider__footer{
  padding-inline-start:0;
  padding-inline-end: var(--page-margin);
}
}


@media(max-width:749px){
  .collection-list-custom .collection-list-slider__layout .collection-list-slider__header {
     padding-inline: var(--util-page-margin-offset);
}
.collection-list-custom .collection-list-slider__layout .resource-list__carousel slideshow-slides{
  padding-inline:var(--gutter-slide-width, 0);
  scroll-padding-inline-start: var(--gutter-slide-width, 0);
}
}
@media(max-width:991px){
 .collection-list-custom  .group-block-content   .text-block.custom-font-size[style*="--font-size: 0.875rem;"]{
    display:none;
 }
}


@media(min-width:750px) and (max-width:1024px){
  .section--page-width .collection-list-slider__layout:not(.collection-list-slider__layout--top){
    padding-inline-start:0;
    flex-direction:column;
  }
  .collection-list-slider__layout:not(.collection-list-slider__layout--top) .collection-list-slider__header{
    flex-basis:unset;
    max-width:unset;
    padding-inline: var(--util-page-margin-offset);
  }
  .collection-list-slider__layout:not(.collection-list-slider__layout--top) .resource-list__carousel slideshow-slides {
        padding-inline: var(--gutter-slide-width, 0);
        scroll-padding-inline-start: var(--gutter-slide-width, 0);
    }
    .collection-list-custom.slide-control-no-gutter .collection-list-slider__footer{
      padding-inline-start:var(--page-margin);
    }
}
{% endstylesheet %}
