                "type_preset": "h6",
                "class_name": "ordering"
              }
            },
            "tab2": {
              "type": "text",
              "settings": {
                "text": "<p>Shipping &amp; Delivery</p>",
                "width": "fit-content",
                "type_preset": "h6",
                "class_name": "shipping"
              }
            },
            "tab3": {
              "type": "text",
              "settings": {
                "text": "<p>Returns &amp; Exchanges</p>",
                "width": "fit-content",
                "type_preset": "h6",
                "class_name": "returns"
              }
            }
          },
          "block_order": ["tab1", "tab2", "tab3"]
        },
        "panel1": {
          "type": "accordion",
          "settings": {
            "class_name": "ordering",
            "dividers": true
          }
        },
        "panel2": {
          "type": "accordion",
          "settings": {
            "class_name": "shipping",
            "dividers": true
          }
        },
        "panel3": {
          "type": "accordion",
          "settings": {
            "class_name": "returns",
            "dividers": true
          }
        }
      },
      "block_order": ["tab-row", "panel1", "panel2", "panel3"]
    }
  ]
}
{% endschema %}
