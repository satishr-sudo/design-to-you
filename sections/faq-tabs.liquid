      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Thickness",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
