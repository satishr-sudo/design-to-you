
{% liquid
  assign max_items = section.settings.max_products
%}

{% if section.settings.layout_type == 'carousel' %}
  <style>
    #shopify-section-{{ section.id }} slideshow-component {
      timeline-scope: var(--slideshow-timeline), --pls-scroll;
    }
    #shopify-section-{{ section.id }} .product-list-slider__inner slideshow-slides {
      scroll-timeline-name: --pls-scroll;
      scroll-timeline-axis: inline;
    }
  </style>

  <script>
    /*
     * Force single-slide navigation for this carousel only.
     *
     * The Horizon slideshow.js computes nextIndex / previousIndex as:
     *   current ± visibleSlides.length
     * so clicking next on a 3-up carousel jumps 3 slides at once.
     *
     * We shadow those two getters on the specific slideshow-component
     * instance inside this section so the step is always exactly 1.
     * No shared theme files are modified.
     */
    (function () {
      var sectionId = {{ section.id | json }};

      customElements.whenDefined('slideshow-component').then(function () {
        var section = document.getElementById('shopify-section-' + sectionId);
        if (!section) return;

        var slideshow = section.querySelector('slideshow-component');
        if (!slideshow) return;

        Object.defineProperty(slideshow, 'nextIndex', {
          get: function () { return this.current + 1; },
          configurable: true
        });

        Object.defineProperty(slideshow, 'previousIndex', {
          get: function () { return this.current - 1; },
          configurable: true
        });
      });
    }());
  </script>
{% endif %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  data-testid="product-list-slider"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    product-list-slider
    spacing-style
    gap-style
    {% if section.settings.custom_class_name  %}{{ section.settings.custom_class_name }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
          <div class="resource-list__item">
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>
          {% unless forloop.last %}<!--@list/split-->{% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div class="resource-list__item">
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>
        {% unless forloop.last %}<!--@list/split-->{% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% if section.settings.layout_type == 'carousel' %}

    {% liquid
      if section.settings.section_width == 'page-width'
        assign gutter_style = '--gutter-slide-width: var(--util-page-margin-offset);'
        if section.settings.header_position == 'left'
          assign slideshow_gutters = 'end'
        else
          assign slideshow_gutters = 'start end'
        endif
      else
        assign slideshow_gutters = null
        assign gutter_style = '--gutter-slide-width: 0px;'
      endif
    %}

    {% capture carousel_slides %}
      {% for item in list_items_array %}
        {% render 'slideshow-slide',
          index: forloop.index0,
          children: item,
          class: 'resource-list__slide'
        %}
      {% endfor %}
    {% endcapture %}

    {% capture carousel_footer %}
      <div class="product-list-slider__footer">
        <div class="product-list-slider__nav">
          {%- render 'slideshow-arrow', action: 'previous', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape -%}
          {%- render 'slideshow-arrow', action: 'next', icon_style: section.settings.icons_style, icon_shape: section.settings.icons_shape -%}
        </div>
        <div class="product-list-slider__progress-track">
          <div class="product-list-slider__progress-fill"></div>
        </div>
      </div>
    {% endcapture %}

    <div class="product-list-slider__layout force-full-width{% if section.settings.header_position != 'left' %} product-list-slider__layout--top{% endif %}">

      <div class="product-list-slider__header">
        {%- content_for 'blocks' -%}
      </div>

      <div
        class="product-list-slider__inner resource-list resource-list__carousel"
        style="
          --resource-list-column-gap-desktop: {{ section.settings.columns_gap }}px;
          --column-count: {{ section.settings.columns }};
          --column-count-mobile: 1;
          --mobile-card-size: {{ section.settings.mobile_card_size | default: '60cqw' }};
        "
      >
        <div class="resource-list__carousel" style="--slide-width-max: 450px; {{ gutter_style }}">
          {% render 'slideshow',
            ref: 'productListSlider',
            class: 'resource-list__carousel',
            slides: carousel_slides,
            show_arrows: false,
            controls: carousel_footer,
            auto_hide_controls: false,
            infinite: false,
            slide_count: max_items,
            slideshow_gutters: slideshow_gutters
          %}
        </div>
      </div>

    </div>

  {% else %}

    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      slide_count: max_items,
      content_type: 'products',
      test_id: 'resource-list-grid'
    %}

  {% endif %}

</div>

{% schema %}
