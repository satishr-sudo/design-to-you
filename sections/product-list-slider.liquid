              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price"]
        }
      },
      "block_order": ["header-group"]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .product-list-slider__layout {
    display: flex;
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    .section--page-width .product-list-slider__layout:not(.product-list-slider__layout--top) {
      padding-inline-start: var(--util-page-margin-offset);
      gap: var(--gap);
    }
  }

  .product-list-slider__layout--top {
    flex-direction: column;
  }

  .section--page-width .product-list-slider__layout--top .product-list-slider__header {
    padding-inline: var(--util-page-margin-offset);
  }

  @media screen and (max-width: 749px) {
    .product-list-slider__layout {
      flex-direction: column;
      gap: var(--gap, 1.5rem);
    }
  }

  .product-list-slider__header {
    flex-shrink: 0;
   
  }
  .product-list-slider .product-list-slider__header {
     width:350px;
    max-width:350px;
   
  }

  .product-list-slider__inner {
    flex: 1;
    min-width: 0;
  }

  .product-list-slider__footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block-start: 1.5rem;
    padding-inline: var(--gutter-slide-width, 0px);
  }

  .product-list-slider__nav {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap:20px;
  }

  .product-list-slider__progress-track {
     flex: 1;
    height: 3px;
    background-color: var(--color-border);
    position: relative;
    overflow: hidden;
    max-width:400px;
    border-radius:50px
  }

  .product-list-slider__progress-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: #240000;
    transform-origin: left;
    transform: scaleX(0);
    animation: product-list-slider-progress linear both;
    animation-timeline: --pls-scroll;
  }

  @keyframes product-list-slider-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

.product-list-custom .product-list-slider__footer button.slideshow-control{
  display: flex;
  align-items: center;
}
  .product-list-custom .product-list-slider__footer .svg-wrapper.icon-arrow
 {
    color: var(--color-input-background);
    height:auto;
    width: auto;
}
.product-list-custom .product-list-slider__footer .svg-wrapper.icon-arrow svg

 {
    width:var(--icon-size-lg);
    height:var(--icon-size-lg);
}
@media(min-width:750px){
  .product-list-custom .product-list-slider__footer{
  padding-left:0;
}
}
@media(max-width:749px){
  .product-list-custom .product-list-slider__layout .product-list-slider__header {
    padding-inline: var(--util-page-margin-offset);
}
.product-list-custom .product-list-slider__layout .resource-list__carousel slideshow-slides:has(product-card){
      padding-inline:var(--gutter-slide-width, 0);
      scroll-padding-inline-start: var(--gutter-slide-width, 0);
}
.product-list-custom .product-list-slider__layout .product-list-slider__header .group-block-content{
  align-items: flex-start;
}
}
{% endstylesheet %}
