      "id": "link_size",
      "label": "Link size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animation_enabled",
      "label": "Enable entrance animation",
      "default": false
    },
    {
      "type": "select",
      "id": "animation_style",
      "label": "Animation style",
      "options": [
        { "value": "fade",       "label": "Fade in"        },
        { "value": "slide-up",   "label": "Slide up"       },
        { "value": "slide-left", "label": "Slide from left"},
        { "value": "zoom",       "label": "Zoom in"        }
      ],
      "default": "fade",
      "visible_if": "{{ section.settings.animation_enabled == true }}"
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Section ID",
      "info": "Override the default section ID. Useful for anchor links (e.g. #sitemap)."
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "info": "Add one or more space-separated class names."
    }
  ],
  "presets": [
    {
      "name": "Advanced Sitemap",
      "category": "Navigation",
      "settings": {
        "heading": "Sitemap",
        "show_collections": true,
        "show_policies": true,
        "show_customer_links": true,
        "show_search": true,
        "columns_desktop": 4,
        "columns_tablet": 3,
        "color_scheme": "scheme-1",
        "padding-block-start": 60,
        "padding-block-end": 60
      },
      "blocks": [
        { "type": "menu_group" },
        { "type": "menu_group" },
        { "type": "menu_group" },
        { "type": "menu_group" }
      ]
    }
  ]
}
