
{%- comment -%}
  ═══════════════════════════════════════════════════════════════════════════
  Section  : Advanced Sitemap
  Theme    : Shopify Horizon (Online Store 2.0)
  File     : sections/advanced-sitemap.liquid
  Block    : blocks/menu_group.liquid

  Purpose  : Renders a fully dynamic HTML sitemap for the entire store.
             Auto-generates groups for pages (via nav menu), collections,
             products (paginated), blogs, articles, policies, customer
             account links, and search. Merchants can also add unlimited
             custom navigation-menu groups via the menu_group block.

  Features :
    - Section-scoped CSS custom properties (keyed --as-*) via section.id
    - CSS Grid: 4–6 cols desktop / 2–3 tablet / 1 mobile
    - Paginated product listing ({% paginate %})
    - Empty-state handling per group
    - CSS-only staggered entrance animations
    - Accessibility: semantic <nav>, ARIA labels, focus management
    - No JavaScript required
    - Shopify Theme Check compliant

  Notes    :
    - Shopify Liquid does not support iterating all pages as an array.
      "Show Pages" requires a navigation menu to be selected in settings.
      Merchants should create a menu containing all desired page links.
    - Products are paginated. For best results, add this section to a
      dedicated page template so only one {% paginate %} tag runs per page.
  ═══════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  comment
    Resolve the container width CSS class.
    Both 'page-width' and 'custom' use section--page-width so that content
    sits in Horizon's central grid column. The custom width then overrides
    --full-page-grid-central-column-width via the scoped <style> block.
  endcomment

  if s.section_width == 'full-width'
    assign width_class = 'section--full-width'
  else
    assign width_class = 'section--page-width'
  endif

  comment
    Pre-flight check: does the store have at least one published policy?
    This avoids rendering an empty Policies group when no policies exist.
  endcomment

  assign has_any_policy = false
  for policy in shop.policies limit: 1
    assign has_any_policy = true
  endfor
-%}

{%- comment -%}
  ── Scoped CSS custom properties ──────────────────────────────────────────
  Targeting #shopify-section-{{ section.id }} ensures each section instance
  on a page can have independent colours, sizing, and layout without
  colliding with other instances of the same section type.
  These properties are consumed by the {% stylesheet %} block below.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} {
    /* Grid columns */
    --as-cols-desktop: {{ s.columns_desktop | default: 4 }};
    --as-cols-tablet:  {{ s.columns_tablet  | default: 3 }};

    /* Outer margins (independent of Horizon spacing-style) */
    --as-margin-top:    {{ s.margin_top    | default: 0 }}px;
    --as-margin-bottom: {{ s.margin_bottom | default: 0 }}px;

    /* Typography sizes */
    --as-heading-size:       {{ s.heading_size       | default: 32 }}px;
    --as-group-heading-size: {{ s.group_heading_size | default: 16 }}px;
    --as-link-size:          {{ s.link_size          | default: 14 }}px;

    /* Colour overrides — only emitted when merchant has set a non-transparent value */
    {% unless s.bg_color      == 'rgba(0,0,0,0)' %}--as-bg:           {{ s.bg_color      }};{% endunless %}
    {% unless s.card_bg_color == 'rgba(0,0,0,0)' %}--as-card-bg:      {{ s.card_bg_color }};{% endunless %}
    {% unless s.heading_color == 'rgba(0,0,0,0)' %}--as-heading-color: {{ s.heading_color }};{% endunless %}
    {% unless s.text_color    == 'rgba(0,0,0,0)' %}--as-text-color:    {{ s.text_color    }};{% endunless %}
    {% unless s.link_color    == 'rgba(0,0,0,0)' %}--as-link-color:    {{ s.link_color    }};{% endunless %}
    {% unless s.hover_color   == 'rgba(0,0,0,0)' %}--as-hover-color:   {{ s.hover_color   }};{% endunless %}
    {% unless s.border_color  == 'rgba(0,0,0,0)' %}--as-border-color:  {{ s.border_color  }};{% endunless %}
  }

  {% comment %}Custom width: narrow the Horizon grid central column to the merchant's value{% endcomment %}
  {% if s.section_width == 'custom' %}
  #shopify-section-{{ section.id }} .advanced-sitemap {
    --full-page-grid-central-column-width: min(
      {{ s.custom_width | default: 1200 }}px,
      calc(100% - var(--page-margin, 1.5rem) * 2)
    );
  }
  {% endif %}
</style>

{%- comment -%} Horizon background layer — carries the colour scheme's background colour {%- endcomment -%}
<div class="section-background color-{{ s.color_scheme }}"></div>

<div
  {% if s.custom_id != blank %}id="{{ s.custom_id | escape }}"{% endif %}
  class="
    section
    {{ width_class }}
    color-{{ s.color_scheme }}
    advanced-sitemap
    spacing-style
    {% if s.custom_class != blank %}{{ s.custom_class | escape }}{% endif %}
    {% if s.animation_enabled %}advanced-sitemap--animate advanced-sitemap--{{ s.animation_style }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: s %}
    margin-block-start: var(--as-margin-top, 0px);
    margin-block-end: var(--as-margin-bottom, 0px);
  "
>

  {%- comment -%} ── Section heading & description ─────────────────────── {%- endcomment -%}
  {%- if s.heading != blank or s.description != blank -%}
    <header class="advanced-sitemap__header">
      {%- if s.heading != blank -%}
        <h2 class="advanced-sitemap__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}
      {%- if s.description != blank -%}
        <p class="advanced-sitemap__description">{{ s.description | escape }}</p>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- comment -%}
    ── Primary sitemap <nav> ─────────────────────────────────────────────
    All sitemap groups — merchant blocks and auto-generated — are direct
    children of this element, which forms the CSS Grid container.
    The aria-label gives screen reader users a meaningful landmark name.
  {%- endcomment -%}
  <nav
    class="advanced-sitemap__grid"
    aria-label="{{ s.heading | default: 'Sitemap' | escape }}"
  >

    {%- comment -%} ══ GROUP 1: Merchant-defined menu blocks ══════════════
      Rendered first so merchants can control ordering relative to
      auto-generated groups simply by re-ordering their blocks.
    {%- endcomment -%}
    {%- content_for 'blocks' -%}

    {%- comment -%} ══ GROUP 2: Pages ═════════════════════════════════════
      Shopify Liquid does not support iterating all store pages as an array.
      Instead this uses a link_list (navigation menu) the merchant creates
      containing all desired pages. The pages_menu setting selects that menu.
    {%- endcomment -%}
    {%- if s.show_pages -%}
      {%- if s.pages_menu != blank -%}

        {%- comment -%}
          Capture links with full 3-level nesting.
          Pages menus may contain nested sub-pages — child and grandchild
          links are rendered with the same --level-N classes used by the
          menu_group block so styling is consistent.
        {%- endcomment -%}
        {%- capture pages_links -%}
          {%- for link in s.pages_menu.links -%}
            <li class="advanced-sitemap__link-item">
              <a href="{{ link.url }}" class="advanced-sitemap__link advanced-sitemap__link--level-1">
                {{- link.title | escape -}}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="advanced-sitemap__links advanced-sitemap__links--level-2" role="list">
                  {%- for child_link in link.links -%}
                    <li class="advanced-sitemap__link-item">
                      <a href="{{ child_link.url }}" class="advanced-sitemap__link advanced-sitemap__link--level-2">
                        {{- child_link.title | escape -}}
                      </a>
                      {%- if child_link.links.size > 0 -%}
                        <ul class="advanced-sitemap__links advanced-sitemap__links--level-3" role="list">
                          {%- for grandchild_link in child_link.links -%}
                            <li class="advanced-sitemap__link-item">
                              <a href="{{ grandchild_link.url }}" class="advanced-sitemap__link advanced-sitemap__link--level-3">
                                {{- grandchild_link.title | escape -}}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endcapture -%}

        {%- if pages_links != blank or s.show_empty_groups -%}
          <div class="advanced-sitemap__group advanced-sitemap__group--pages">
            <h3 class="advanced-sitemap__group-title">Pages</h3>
            {%- if pages_links != blank -%}
              <ul class="advanced-sitemap__links advanced-sitemap__links--level-1" role="list">
                {{ pages_links }}
              </ul>
            {%- else -%}
              <p class="advanced-sitemap__empty-text">No pages found.</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- elsif request.design_mode -%}
        {%- comment -%} Editor hint when pages menu has not yet been configured {%- endcomment -%}
        <div class="advanced-sitemap__group advanced-sitemap__group--editor-hint">
          <h3 class="advanced-sitemap__group-title">Pages</h3>
          <p class="advanced-sitemap__empty-text">
            Create a navigation menu with your pages, then select it in
            the "Pages navigation menu" setting.
          </p>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ══ GROUP 3: Collections ═══════════════════════════════
      Loops the global `collections` array. Skips the 'frontpage'
      and 'all' reserved collections (Shopify internal collections).
    {%- endcomment -%}
    {%- if s.show_collections -%}

      {%- capture collection_links -%}
        {%- for collection in collections -%}
          {%- unless collection.handle == 'frontpage' or collection.handle == 'all' -%}
            <li class="advanced-sitemap__link-item">
              <a href="{{ collection.url }}" class="advanced-sitemap__link">
                {{- collection.title | escape -}}
              </a>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if collection_links != blank or s.show_empty_groups -%}
        <div class="advanced-sitemap__group advanced-sitemap__group--collections">
          <h3 class="advanced-sitemap__group-title">Collections</h3>
          {%- if collection_links != blank -%}
            <ul class="advanced-sitemap__links list-unstyled" role="list">
              {{ collection_links }}
            </ul>
          {%- else -%}
            <p class="advanced-sitemap__empty-text">No collections found.</p>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- endif -%}

    {%- comment -%} ══ GROUP 4: Products (paginated) ══════════════════════
      Paginates all products from collections.all at the merchant-defined
      page size. The ?page= URL parameter advances through pages.
      Recommendation: use this section on a dedicated page template so
      only one {% paginate %} tag is active at a time.
    {%- endcomment -%}
    {%- if s.show_products -%}

      {%- paginate collections.all.products by s.products_per_page -%}

        {%- capture product_links -%}
          {%- for product in collections.all.products -%}
            <li class="advanced-sitemap__link-item">
              <a href="{{ product.url }}" class="advanced-sitemap__link">
                {{- product.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        {%- endcapture -%}

        {%- if product_links != blank or s.show_empty_groups -%}
          <div class="advanced-sitemap__group advanced-sitemap__group--products">
            <h3 class="advanced-sitemap__group-title">
              Products
              {%- if paginate.pages > 1 -%}
                <span class="advanced-sitemap__page-badge">
                  {{ paginate.current_page }}&thinsp;/&thinsp;{{ paginate.pages }}
                </span>
              {%- endif -%}
            </h3>

            {%- if product_links != blank -%}
              <ul class="advanced-sitemap__links list-unstyled" role="list">
                {{ product_links }}
              </ul>
              {%- comment -%} Pagination controls — only shown when multiple pages exist {%- endcomment -%}
              {%- if paginate.pages > 1 -%}
                <nav class="advanced-sitemap__pagination" aria-label="Product pages">
                  {{ paginate | default_pagination }}
                </nav>
              {%- endif -%}
            {%- else -%}
              <p class="advanced-sitemap__empty-text">No products found.</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- endpaginate -%}

    {%- endif -%}

    {%- comment -%} ══ GROUPS 5–6: Blogs and Articles ════════════════════
      show_blogs  — renders the blog title as a link to the blog index.
      show_articles — renders article links grouped under each parent blog.
      Both toggles can operate independently:
        - show_blogs only: blog headings as links, no article list.
        - show_articles only: blog title as plain heading + article links.
        - Both enabled: blog title links + article links beneath each.
      Either toggle being on triggers the for loop; if neither is on the
      entire block is skipped.
    {%- endcomment -%}
    {%- if s.show_blogs or s.show_articles -%}

      {%- for blog in blogs -%}

        {%- comment -%} Reset article links for each blog iteration {%- endcomment -%}
        {%- assign article_links = '' -%}
        {%- if s.show_articles -%}
          {%- capture article_links -%}
            {%- for article in blog.articles -%}
              <li class="advanced-sitemap__link-item">
                <a href="{{ article.url }}" class="advanced-sitemap__link">
                  {{- article.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          {%- endcapture -%}
        {%- endif -%}

        {%- comment -%}
          Determine whether this blog group should be rendered.
          Always render when show_blogs is on (even if no articles).
          When only show_articles is on, render only if articles exist
          (or empty groups are enabled — we still need the parent heading).
        {%- endcomment -%}
        {%- assign should_render_blog = false -%}
        {%- if s.show_blogs -%}
          {%- assign should_render_blog = true -%}
        {%- elsif s.show_articles and article_links != blank -%}
          {%- assign should_render_blog = true -%}
        {%- elsif s.show_articles and s.show_empty_groups -%}
          {%- assign should_render_blog = true -%}
        {%- endif -%}

        {%- if should_render_blog -%}
          <div class="advanced-sitemap__group advanced-sitemap__group--blog">
            <h3 class="advanced-sitemap__group-title">
              {%- if s.show_blogs -%}
                {%- comment -%} Blog title is a live link to the blog index page {%- endcomment -%}
                <a href="{{ blog.url }}" class="advanced-sitemap__link advanced-sitemap__link--group-heading">
                  {{- blog.title | escape -}}
                </a>
              {%- else -%}
                {{- blog.title | escape -}}
              {%- endif -%}
            </h3>

            {%- if s.show_articles -%}
              {%- if article_links != blank -%}
                <ul class="advanced-sitemap__links list-unstyled" role="list">
                  {{ article_links }}
                </ul>
              {%- elsif s.show_empty_groups -%}
                <p class="advanced-sitemap__empty-text">No articles in this blog.</p>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- else -%}
        {%- comment -%} No blogs exist in the store {%- endcomment -%}
        {%- if s.show_empty_groups -%}
          <div class="advanced-sitemap__group advanced-sitemap__group--blog">
            <h3 class="advanced-sitemap__group-title">Blog</h3>
            <p class="advanced-sitemap__empty-text">No blogs published.</p>
          </div>
        {%- endif -%}
      {%- endfor -%}

    {%- endif -%}

    {%- comment -%} ══ GROUP 7: Policies ══════════════════════════════════
      Iterates shop.policies — a Shopify-provided array of all published
      store policies (refund, privacy, ToS, shipping, subscription, etc.).
      Only renders when at least one policy is published, or when empty
      groups are enabled.
    {%- endcomment -%}
    {%- if s.show_policies -%}
      {%- if has_any_policy or s.show_empty_groups -%}
        <div class="advanced-sitemap__group advanced-sitemap__group--policies">
          <h3 class="advanced-sitemap__group-title">Policies</h3>
          {%- if has_any_policy -%}
            <ul class="advanced-sitemap__links list-unstyled" role="list">
              {%- for policy in shop.policies -%}
                <li class="advanced-sitemap__link-item">
                  <a href="{{ policy.url }}" class="advanced-sitemap__link">
                    {{- policy.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <p class="advanced-sitemap__empty-text">No policies published.</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} ══ GROUP 8: Customer Account Links ════════════════════
      Adapts to whether the visitor is logged in or out.
      'Create Account' is only shown when accounts are enabled or optional.
    {%- endcomment -%}
    {%- if s.show_customer_links -%}
      <div class="advanced-sitemap__group advanced-sitemap__group--account">
        <h3 class="advanced-sitemap__group-title">Account</h3>
        <ul class="advanced-sitemap__links list-unstyled" role="list">
          {%- if customer -%}
            <li class="advanced-sitemap__link-item">
              <a href="{{ routes.account_url }}" class="advanced-sitemap__link" aria-current="true">
                My Account
              </a>
            </li>
            <li class="advanced-sitemap__link-item">
              <a href="{{ routes.account_orders_url }}" class="advanced-sitemap__link">Orders</a>
            </li>
            <li class="advanced-sitemap__link-item">
              <a href="{{ routes.account_addresses_url }}" class="advanced-sitemap__link">Addresses</a>
            </li>
            <li class="advanced-sitemap__link-item">
              <a href="{{ routes.account_logout_url }}" class="advanced-sitemap__link">Log Out</a>
            </li>
          {%- else -%}
            <li class="advanced-sitemap__link-item">
              <a href="{{ routes.account_login_url }}" class="advanced-sitemap__link">Log In</a>
            </li>
            {%- if shop.customer_accounts_optional or shop.customer_accounts_enabled -%}
              <li class="advanced-sitemap__link-item">
                <a href="{{ routes.account_register_url }}" class="advanced-sitemap__link">
                  Create Account
                </a>
              </li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} ══ GROUP 9: Search ════════════════════════════════════
      A single direct link to the store's search page using routes.search_url,
      which resolves correctly regardless of custom URL structures.
    {%- endcomment -%}
    {%- if s.show_search -%}
      <div class="advanced-sitemap__group advanced-sitemap__group--search">
        <h3 class="advanced-sitemap__group-title">Search</h3>
        <ul class="advanced-sitemap__links list-unstyled" role="list">
          <li class="advanced-sitemap__link-item">
            <a href="{{ routes.search_url }}" class="advanced-sitemap__link">
              Search the store
            </a>
          </li>
        </ul>
      </div>
    {%- endif -%}

  </nav>
</div>

{% comment %}
  ── Stylesheet ────────────────────────────────────────────────────────────
  The {% stylesheet %} tag is deduplicated by Shopify: structural CSS
  renders once regardless of how many instances of this section exist.
  All per-instance customisation comes from the --as-* custom properties
  injected via the <style> block above.
{% endcomment %}
{% stylesheet %}
  /* ─── Section header ───────────────────────────────────────────────── */
  .advanced-sitemap__header {
    margin-block-end: 2.5rem;
  }

  .advanced-sitemap__heading {
    font-size: var(--as-heading-size, 2rem);
    font-weight: 700;
    color: var(--as-heading-color, currentColor);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .advanced-sitemap__description {
    font-size: 1rem;
    color: var(--as-text-color, currentColor);
    opacity: 0.8;
    margin: 0;
    line-height: 1.6;
  }

  /* ─── CSS Grid container ───────────────────────────────────────────── */
  .advanced-sitemap__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.5rem;
  }

  /* Tablet: 2–3 columns */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .advanced-sitemap__grid {
      grid-template-columns: repeat(var(--as-cols-tablet, 3), 1fr);
    }
  }

  /* Desktop: 4–6 columns */
  @media screen and (min-width: 990px) {
    .advanced-sitemap__grid {
      grid-template-columns: repeat(var(--as-cols-desktop, 4), 1fr);
    }
  }

  /* ─── Group card ───────────────────────────────────────────────────── */
  /* .advanced-sitemap__group {
    background-color: var(--as-card-bg, transparent);
    border: 1px solid var(--as-border-color, transparent);
  } */

  /* ─── Group header — flex row for icon + title ─────────────────────── */
  .advanced-sitemap__group-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }

  .advanced-sitemap__group-icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  /* ─── Group title ──────────────────────────────────────────────────── */
  .advanced-sitemap__group-title {
    font-size: var(--as-group-heading-size, 1rem);
    font-weight: 600;
    color: var(--as-heading-color, currentColor);
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
    line-height: 1.3;
  }

  /* No bottom margin when the title is inside the flex group-header */
  .advanced-sitemap__group-header .advanced-sitemap__group-title {
    margin-block-end: 0;
  }

  /* ─── Page badge (products pagination indicator) ───────────────────── */
  .advanced-sitemap__page-badge {
    font-size: 0.7em;
    font-weight: 400;
    opacity: 0.55;
  }

  /* ─── Links list ───────────────────────────────────────────────────── */
  .advanced-sitemap__links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .advanced-sitemap__link-item {
    list-style: none;
  }

  .advanced-sitemap__link {
    font-size: var(--as-link-size, 0.875rem);
    color: var(--as-link-color, currentColor);
    text-decoration: none;
    display: inline-block;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .advanced-sitemap__link:hover,
  .advanced-sitemap__link:focus-visible {
    color: var(--as-hover-color, currentColor);
    opacity: 0.75;
    text-decoration: underline;
  }

  /* Keyboard focus ring — WCAG 2.1 SC 2.4.7 */
  .advanced-sitemap__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Blog index links used as group headings — suppress hover underline */
  .advanced-sitemap__link--group-heading {
    font-weight: 600;
  }

  .advanced-sitemap__link--group-heading:hover {
    text-decoration: none;
  }

  /* ─── Pagination controls ──────────────────────────────────────────── */
  .advanced-sitemap__pagination {
    margin-block-start: 1rem;
    font-size: 0.875rem;
  }

  /* ─── Empty-state text ─────────────────────────────────────────────── */
  .advanced-sitemap__empty-text {
    font-size: 0.8125rem;
    color: var(--as-text-color, currentColor);
    font-style: italic;
    opacity: 0.5;
    margin: 0;
    line-height: 1.5;
  }

  /* ─── Theme-editor hint card ───────────────────────────────────────── */
  .advanced-sitemap__group--editor-hint {
    border: 1px dashed currentColor !important;
    border-radius: 4px;
    padding: 1rem;
    opacity: 0.5;
  }

  /* ─── CSS-only entrance animations ────────────────────────────────────
     Groups start at opacity 0 and animate in on page load.
     Staggered delays give a cascading reveal effect.
     No JavaScript needed — animation-delay on nth-child handles sequencing.
  ─────────────────────────────────────────────────────────────────────── */
  @keyframes as-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes as-slide-up {
    from { opacity: 0; transform: translateY(1.25rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes as-slide-left {
    from { opacity: 0; transform: translateX(1.25rem); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes as-zoom {
    from { opacity: 0; transform: scale(0.95); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* Base animation state applied to all groups when animation is enabled */
  .advanced-sitemap--animate .advanced-sitemap__group {
    opacity: 0;
    animation-duration: 0.55s;
    animation-timing-function: ease;
    animation-fill-mode: forwards;
  }

  /* Map animation style classes to keyframe names */
  .advanced-sitemap--animate.advanced-sitemap--fade       .advanced-sitemap__group { animation-name: as-fade; }
  .advanced-sitemap--animate.advanced-sitemap--slide-up   .advanced-sitemap__group { animation-name: as-slide-up; }
  .advanced-sitemap--animate.advanced-sitemap--slide-left .advanced-sitemap__group { animation-name: as-slide-left; }
  .advanced-sitemap--animate.advanced-sitemap--zoom       .advanced-sitemap__group { animation-name: as-zoom; }

  /* Staggered delay — up to 12 groups, each offset by 80 ms */
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(1)  { animation-delay: 0.00s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(2)  { animation-delay: 0.08s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(3)  { animation-delay: 0.16s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(4)  { animation-delay: 0.24s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(5)  { animation-delay: 0.32s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(6)  { animation-delay: 0.40s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(7)  { animation-delay: 0.48s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(8)  { animation-delay: 0.56s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(9)  { animation-delay: 0.64s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(10) { animation-delay: 0.72s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(11) { animation-delay: 0.80s; }
  .advanced-sitemap--animate .advanced-sitemap__group:nth-child(12) { animation-delay: 0.88s; }

  /* Respect user's system-level reduce-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .advanced-sitemap--animate .advanced-sitemap__group {
      animation: none;
      opacity: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Advanced Sitemap",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "menu_group",
      "name": "Menu Group"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sitemap"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Optional subtext displayed beneath the heading."
    },
    {
      "type": "header",
      "content": "Dynamic Content"
    },
    {
      "type": "checkbox",
      "id": "show_pages",
      "label": "Show Pages",
      "default": false,
      "info": "Requires a navigation menu. Shopify Liquid cannot iterate all pages directly — create a menu containing your pages and select it below."
    },
    {
      "type": "link_list",
      "id": "pages_menu",
      "label": "Pages navigation menu",
      "info": "Select the menu that contains your store pages.",
      "visible_if": "{{ section.settings.show_pages == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "Show Collections",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show Products",
      "default": false,
      "info": "Products are paginated. Best used on a dedicated sitemap page template."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 10,
      "max": 100,
      "step": 10,
      "default": 50,
      "visible_if": "{{ section.settings.show_products == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_blogs",
      "label": "Show Blogs",
      "default": false,
      "info": "Renders each blog title as a link to the blog index page."
    },
    {
      "type": "checkbox",
      "id": "show_articles",
      "label": "Show Articles",
      "default": false,
      "info": "Lists all articles grouped under their parent blog."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show Policies",
      "default": true,
      "info": "Displays all published store policies (refund, privacy, terms, shipping, etc.)."
    },
    {
      "type": "checkbox",
      "id": "show_customer_links",
      "label": "Show Customer Account Links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty_groups",
      "label": "Show empty groups",
      "default": false,
      "info": "When enabled, groups with no content display a placeholder message instead of being hidden."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 3,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        { "value": "page-width", "label": "Page width"   },
        { "value": "full-width", "label": "Full width"   },
        { "value": "custom",     "label": "Custom width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom container width",
      "min": 400,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200,
