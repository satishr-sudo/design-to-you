      "id": "image_1_alt",
      "label": "Top-left image alt text",
      "info": "Describe the image for screen readers and SEO"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image — top right"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Top-right image alt text"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image — bottom left"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Bottom-left image alt text"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image — bottom right"
    },
    {
      "type": "text",
      "id": "image_4_alt",
      "label": "Bottom-right image alt text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 200
    },
